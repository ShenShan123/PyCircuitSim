+class _PhysicsSkeletonId(nn.Module):
+    """Closed-form BSIM-style Id skeleton (B7, V6.4.5 Track-B).
+
+    Implements a 3-region (subthreshold / linear / saturation) Id model in
+    the NN-frame PHYSICAL terminal voltages (Vgs, Vds, Vbs).
+
+    The forward receives NORMALISED inputs ``x`` (shape (B, 7)):
+        x[:,0] = norm(Vd), x[:,1] = norm(Vg), x[:,2] = norm(Vs),
+        x[:,3] = norm(Vb), x[:,4] = norm(NFIN_log), x[:,5] = norm(L),
+        x[:,6] = norm(T).
+
+    The skeleton denormalises Vd,Vg,Vs,Vb via registered buffers
+    ``in_mean`` / ``in_std`` (first 4 dims of the norm.npz input stats),
+    then computes physical Vgs = Vg-Vs, Vds = Vd-Vs, Vbs = Vb-Vs, NFIN
+    (from log-NFIN), and evaluates the 3-region formula.
+
+    PyCMG sign convention: NMOS conducting id is **negative** (current flows
+    into the drain terminal), so id_skeleton ≤ 0 for NMOS ON-state.
+    The ``nmos_sign`` buffer carries -1.0 for NMOS and +1.0 for PMOS so one
+    module class covers both. The sign is persisted in the state_dict.
+
+    All 3 region boundaries use smooth blends (softplus) so the output is
+    C1 — required for NR convergence (Rule 4).
+
+    Learnable parameters (~12 per model):
+        Vth0, n_factor, beta_log (log of β for numerical stability),
+        lambda_log (log of λ), gamma, phi_log (log of φ), log_I0,
+        k_blend (Vov=0 softplus width), vt_phys (effective thermal voltage
+        — learned to adapt to temperature / tech — init at 0.026 V).
+
+    All parameters are initialized to physically plausible FinFET 7 nm values.
+    """
+
+    def __init__(
+        self,
+        in_mean: torch.Tensor,    # (7,) input mean from norm.npz
+        in_std: torch.Tensor,     # (7,) input std from norm.npz
+        nmos_sign: float = -1.0,  # -1 for NMOS (id < 0 ON), +1 for PMOS
+        vdd_train: float = 0.75,
+        # Output normalization for the id column (asinh mode):
+        # id_norm = (asinh(id_phys / asinh_scale_id) - id_out_mean) / id_out_std
+        # These buffers allow the skeleton to return a NORMALIZED output so it
+        # can be added to the base head (which is also in normalized space).
+        # If all three are None, the skeleton returns physical units (backward-
+        # compat, but the mixed-units forward is dimensionally inconsistent).
+        id_asinh_scale: "float | None" = None,
+        id_out_mean: "float | None" = None,
+        id_out_std: "float | None" = None,
+    ) -> None:
+        super().__init__()
+        # Store norm stats as buffers so they move with the module
+        # (to(device) / state_dict round-trip).
+        self.register_buffer("in_mean", in_mean.float().clone())
+        self.register_buffer("in_std", in_std.float().clone())
+        self.register_buffer("nmos_sign", torch.tensor(float(nmos_sign)))
+        self.register_buffer("vdd_train_buf", torch.tensor(float(vdd_train)))
+        # Output normalization (optional; stored as scalar buffers).
+        _use_out_norm = (id_asinh_scale is not None
+                         and id_out_mean is not None
+                         and id_out_std is not None)
+        self.register_buffer(
+            "use_out_norm", torch.tensor(float(_use_out_norm)))
+        self.register_buffer(
+            "id_asinh_scale",
+            torch.tensor(float(id_asinh_scale) if id_asinh_scale else 1.0))
+        self.register_buffer(
+            "id_out_mean",
+            torch.tensor(float(id_out_mean) if id_out_mean is not None else 0.0))
+        self.register_buffer(
+            "id_out_std",
+            torch.tensor(float(id_out_std) if id_out_std is not None else 1.0))
+
+        # ── Learnable physical parameters ──────────────────────────────
+        # Calibrated to TSMC7 NMOS dataset (PyCMG): at Vgs=0.75V, Vds=0.375V,
+        # NFIN=1, id ≈ -2e-5 A. In saturation: id_sat = 0.5*β*Vov²*(1+λ*Vds)
+        # with Vov≈0.45V, Vds=0.375V: β ≈ 1.8e-4 A/V² per fin. Below Vth=0.3V
+        # at Vgs=0V (Vov=-0.3V): id_sub = I0*exp(-0.3/(n*vt)) ≈ I0*exp(-8.5) ≈
+        # I0*2e-4; at Vgs=0.3V (threshold): id ≈ I0. Subthreshold slope for
+        # FinFETs: SS ≈ 65 mV/dec → n ≈ 1.1.
+        self.Vth0 = nn.Parameter(torch.tensor(0.28))       # V (SVT ~0.28-0.32)
+        self.n_factor = nn.Parameter(torch.tensor(-2.3))   # n=1+exp(n_factor)≥1; init n≈1.1
+        self.beta_log = nn.Parameter(torch.tensor(-8.6))   # log(β), β≈1.8e-4 A/V²/fin
+        self.lambda_log = nn.Parameter(torch.tensor(-1.2)) # log(λ), λ≈0.3 V⁻¹
+        self.gamma = nn.Parameter(torch.tensor(0.05))      # body-effect coeff (small for FinFET)
+        self.phi_log = nn.Parameter(torch.tensor(-0.36))   # log(φ), φ≈0.7 V
+        self.log_I0 = nn.Parameter(torch.tensor(-12.0))    # log(I0/fin), I0≈6e-6 A/fin at threshold
+        self.k_blend = nn.Parameter(torch.tensor(10.0))    # Vov blend sharpness
+        # vt stored in log-space to allow gradient descent while keeping vt>0:
+        # vt = exp(log_vt); init log(0.026) ≈ -3.65.
+        self.log_vt = nn.Parameter(torch.tensor(-3.65))    # log(vt), vt≈0.026 V
+
+    def _denorm_voltages(
+        self, x: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor,
+               torch.Tensor]:
+        """Recover physical Vd, Vg, Vs, Vb, NFIN from normalised x (B,7)."""
+        # Reverse z-score for first 4 dims (voltages)
+        v_phys = x[:, :4] * self.in_std[:4] + self.in_mean[:4]  # (B,4)
+        vd, vg, vs, vb = v_phys[:, 0], v_phys[:, 1], v_phys[:, 2], v_phys[:, 3]
+        # NFIN_log is dim 4: recover NFIN = 2^(NFIN_log_phys)
+        nfin_log_phys = x[:, 4] * self.in_std[4] + self.in_mean[4]
+        nfin = torch.exp(nfin_log_phys * 0.6931472)  # 2^x = exp(x*ln2)
+        return vd, vg, vs, vb, nfin
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        """Return Id_skeleton (B, 1) in PyCMG sign convention."""
+        vd, vg, vs, vb, nfin = self._denorm_voltages(x)
+
+        vgs = vg - vs
+        vds = vd - vs
+        vbs = vb - vs
+
+        # ── Physical parameters (constrained to sensible ranges) ───────
+        # n_factor ≥ 1 (subthreshold swing factor); store raw, map via exp+1
+        n = torch.exp(self.n_factor) + 1.0  # n = 1 + exp(n_factor) ≥ 1
+        # β > 0 (stored in log-space)
+        beta = torch.exp(self.beta_log)
+        # λ > 0 (stored in log-space)
+        lam = torch.exp(self.lambda_log)
+        # φ > 0 (surface potential; stored in log-space + 0.05 floor)
+        phi = torch.exp(self.phi_log) + 0.05
+        # γ (body-effect coefficient; can be near-zero)
+        gamma = self.gamma
+        # I0 > 0 (subthreshold current scale per fin, stored in log-space)
+        I0 = torch.exp(self.log_I0)
+        # vt > 0 stored in log-space: vt = exp(log_vt); init at 0.026 V
+        vt = torch.exp(self.log_vt)
+
+        # ── Body effect on Vth ─────────────────────────────────────────
+        # Vth_eff = Vth0 + γ·(sqrt(φ + |Vbs|) − sqrt(φ))
+        # Use softplus(|Vbs| + φ) ≈ |Vbs| + φ for stability
+        abs_vbs = torch.abs(vbs)
+        sqrt_phi_vbs = torch.sqrt(phi + abs_vbs + 1e-6)
+        sqrt_phi = torch.sqrt(phi + 1e-6)
+        vth_eff = self.Vth0 + gamma * (sqrt_phi_vbs - sqrt_phi)
+
+        # ── Overdrive voltage Vov = |Vgs| - Vth_eff ───────────────────
+        # For NMOS: Vgs is positive when on (PMOS frame: Vgs negative in
+        # source-relative training frame). Work with |Vgs| so one formula
+        # covers both. The nmos_sign at output flips for PMOS.
+        vgs_abs = torch.abs(vgs)
+        vov = vgs_abs - vth_eff
+
+        # ── Subthreshold region (Vov < 0) ─────────────────────────────
+        # Id_sub = I0·NFIN·exp(Vov/(n·vt))·(1 - exp(-|Vds|/(vt)))
+        # Both factors are clamped: Vov/(n·vt) in (-∞, 0] for subthreshold.
+        # The (1-exp) factor goes to 1 for large |Vds|.
+        nvt = n * vt
+        exp_vov = torch.exp(torch.clamp(vov / nvt, max=0.0))  # ≤ 1
+        abs_vds = torch.abs(vds)
+        sat_factor_sub = 1.0 - torch.exp(torch.clamp(-abs_vds / vt, max=0.0))
+        id_sub = I0 * nfin * exp_vov * sat_factor_sub
+
+        # ── Above-threshold regions (Vov > 0) ─────────────────────────
+        # For Vds < Vov (linear):  Id = β·NFIN·(Vov·|Vds| - Vds²/2)
+        # For Vds ≥ Vov (saturation): Id = ½·β·NFIN·Vov²·(1+λ·|Vds|)
+        # Smooth blend: use softplus(Vov - |Vds|) to switch
+        vov_pos = F.softplus(vov)  # differentiable positive part of Vov
+        # vds_eff for the linear region: min(|Vds|, Vov) — softmin
+        k_b = F.softplus(self.k_blend) + 1.0  # sharpness > 0
+        # Smooth min(a,b) = -(1/k)·log(exp(-k·a)+exp(-k·b))
+        ka = -k_b * abs_vds
+        kb2 = -k_b * vov_pos
+        log_sum = torch.logaddexp(ka, kb2)
+        vds_eff = -log_sum / k_b  # smooth min(|Vds|, Vov_pos)
+
+        id_lin = beta * nfin * (vov_pos * vds_eff - 0.5 * vds_eff * vds_eff)
+        id_sat = 0.5 * beta * nfin * vov_pos * vov_pos * (1.0 + lam * abs_vds)
+
+        # Smooth blend between linear and saturation regions:
+        # weight_sat = sigmoid(k_blend · (|Vds| - Vov))
+        # weight_lin = 1 - weight_sat
+        blend_arg = k_b * (abs_vds - vov_pos)
+        w_sat = torch.sigmoid(blend_arg)
+        w_lin = 1.0 - w_sat
+        id_above = w_lin * id_lin + w_sat * id_sat
+
+        # ── Blend subthreshold ↔ above-threshold ──────────────────────
+        # Use exp(Vov/vt) as a smooth gate: near 0 when Vov≪0 (sub), 1 when Vov≫0
+        w_above = torch.sigmoid(k_b * vov)
+        w_below = 1.0 - w_above
+        id_mag = w_below * id_sub + w_above * id_above
+
+        # ── Vds direction (only forward-bias contributes) ──────────────
+        # If NMOS: vds > 0 is the conduction direction.
+        # If PMOS (source-relative frame): vds < 0 is the conduction direction.
+        # Apply the sign via nmos_sign: for NMOS nmos_sign=-1 means id<0 when ON.
+        # The conductance direction is |vds| > 0 and we already use abs_vds above.
+        # Suppress reverse-Vds current with a smooth gate.
+        # Directional gate: suppress reverse-Vds conduction smoothly.
+        # NMOS normal conduction: vds > 0. Gate = sigmoid(k*vds/vt).
+        # PMOS: in the source-relative training frame, vds < 0 when conducting
+        # (source is at 0, drain is pulled down). Gate = sigmoid(-k*vds/vt).
+        # nmos_sign=-1 for NMOS, +1 for PMOS. The conducting-direction sign
+        # is -nmos_sign (NMOS→+1 means vds>0; PMOS→-1 means vds<0).
+        #
+        # NMOS: (-nmos_sign)*vds = (+1)*vds = vds; large positive when on. ✓
+        # PMOS: (-nmos_sign)*vds = (-1)*vds; large positive when vds<0 (on). ✓
+        vds_direction = (-self.nmos_sign) * vds   # positive in conduction direction
+        f_dir = torch.sigmoid(torch.clamp(k_b * vds_direction / vt, min=-100.0, max=100.0))
+
+        id_raw = id_mag * f_dir  # always ≥ 0
+        # PyCMG sign convention: NMOS ON → id < 0; PMOS ON → id > 0.
+        # nmos_sign=-1 for NMOS: id_out = -id_raw ≤ 0 ✓
+        # nmos_sign=+1 for PMOS: id_out = +id_raw ≥ 0 ✓
+        id_phys = self.nmos_sign * id_raw   # physical units (A)
+
+        # Optionally re-normalise to asinh-z-score output space so the skeleton
+        # is dimensionally consistent with the base head (which is in norm space).
+        # Without this, id_phys (~1e-5 A) mixed with the base head (~O(1))
+        # would make the trunk ignore the skeleton entirely.
+        if self.use_out_norm > 0.5:
+            # asinh normalisation: y_inner = asinh(y_phys / scale)
+            id_inner = torch.asinh(id_phys / (self.id_asinh_scale + 1e-30))
+            id_out = (id_inner - self.id_out_mean) / (self.id_out_std + 1e-30)
+        else:
+            id_out = id_phys
+
+        return id_out.unsqueeze(-1)   # (B, 1)
+
