Nm1 VB4 net013 VDDA VDDA psvt_l240_f1 m=8   $ BIASCM_PMOS
Nm0 net013 net013 VDDA VDDA psvt_l240_f1 m=8   $ BIASCM_PMOS
Nm14 VB3 VB3 GNDA GNDA nsvt_l240_f1 m=18   $ BIASCM_NMOS
Nm23 VOUT net049 GNDA GNDA nsvt_l35_f4 m=8   $ gm3_NMOS
Nm22 net049 net043 GNDA GNDA nsvt_l24_f10 m=240   $ LOAD2_NMOS
