Nm8 DM_2 VINN net31 net31 psvt_l184_f8 m=2   $ gm1_PMOS
Nm4 net31 net013 VDDA VDDA psvt_l240_f1 m=32   $ BIASCM_PMOS
Nm3 VB3 net013 VDDA VDDA psvt_l240_f1 m=8   $ BIASCM_PMOS
