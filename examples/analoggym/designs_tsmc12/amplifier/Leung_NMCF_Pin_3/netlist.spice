Nm15 VOUTN VB3 DM_2 GNDA nsvt_l240_f1 m=72   $ BIASCM_NMOS
Nm20 net063 VB4 GNDA GNDA nsvt_l240_f1 m=144   $ BIASCM_NMOS
Nm16 net050 VB3 net063 GNDA nsvt_l240_f1 m=72   $ BIASCM_NMOS
Nm17 net54 VB4 GNDA GNDA nsvt_l240_f1 m=72   $ BIASCM_NMOS
