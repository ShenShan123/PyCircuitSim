Nm19 net56 VB4 GNDA GNDA nsvt_l150_f1 m=64   $ BIASCM_NMOS
Nm14 DM_1 VB3 net56 GNDA nsvt_l150_f1 m=64   $ BIASCM_NMOS
I0 net1 GNDA 8e-06
C1 net050 VOUT 4e-12
C2 net050 net2 5e-13
.ends leung_dfcfc2_pin_3
