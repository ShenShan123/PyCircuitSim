Nm5 VOUTN VOUTN VDDA VDDA psvt_l240_f7 m=3   $ BIASCM_PMOS
Nm9 net063 VINP net31 net31 psvt_l96_f10 m=2   $ gm1_PMOS
Nm8 DM_2 VINN net31 net31 psvt_l96_f10 m=2   $ gm1_PMOS
Nm4 net31 net1 VDDA VDDA psvt_l240_f7 m=6   $ BIASCM_PMOS
Nm3 VB3 net1 VDDA VDDA psvt_l240_f7 m=3   $ BIASCM_PMOS
Nm2 DM_1 net1 VDDA VDDA psvt_l240_f7 m=3   $ BIASCM_PMOS
Nm1 VB4 net1 VDDA VDDA psvt_l240_f7 m=3   $ BIASCM_PMOS
Nm0 net1 net1 VDDA VDDA psvt_l240_f7 m=3   $ BIASCM_PMOS
Nm25 VOUT net049 GNDA GNDA nsvt_l149_f4 m=11   $ gm3_NMOS
Nm24 net049 net043 GNDA GNDA nsvt_l38_f6 m=54   $ LOAD2_NMOS
Nm23 net043 net043 GNDA GNDA nsvt_l38_f6 m=54   $ LOAD2_NMOS
Nm20 DM_2 VB4 GNDA GNDA nsvt_l150_f1 m=128   $ BIASCM_NMOS
Nm16 VOUTN VB3 DM_2 GNDA nsvt_l150_f1 m=64   $ BIASCM_NMOS
Nm21 net063 VB4 GNDA GNDA nsvt_l150_f1 m=128   $ BIASCM_NMOS
Nm17 net050 VB3 net063 GNDA nsvt_l150_f1 m=64   $ BIASCM_NMOS
Nm18 net54 VB4 GNDA GNDA nsvt_l150_f1 m=64   $ BIASCM_NMOS
Nm22 net2 VB4 GNDA GNDA nsvt_l150_f1 m=64   $ BIASCM_NMOS
Nm15 VB3 VB3 GNDA GNDA nsvt_l150_f1 m=16   $ BIASCM_NMOS
