Nm0 net013 net013 VDDA VDDA psvt_l128_f4 m=16   $ BIASCM_PMOS
Nm61 net4 VB4 GNDA GNDA nsvt_l128_f4 m=32   $ BIASCM_NMOS
Nm59 net4 net1 GNDA GNDA nsvt_l110_f6 m=9   $ gmb_NMOS
Nm19 DM_2 VB4 GNDA GNDA nsvt_l128_f4 m=32   $ BIASCM_NMOS
Nm15 VOUTN VB3 DM_2 GNDA nsvt_l128_f4 m=16   $ BIASCM_NMOS
Nm20 net063 VB4 GNDA GNDA nsvt_l128_f4 m=32   $ BIASCM_NMOS
