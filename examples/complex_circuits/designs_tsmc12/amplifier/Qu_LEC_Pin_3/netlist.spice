Nm17 net6 VB4 GNDA GNDA nsvt_l128_f4 m=16   $ BIASCM_NMOS
Nm69 VOUT net5 GNDA GNDA nsvt_l36_f12 m=16   $ gm3_NMOS
Nm66 net5 net4 GNDA GNDA nsvt_l110_f8 m=18   $ gm2_NMOS
Nm65 net3 net4 GNDA GNDA nsvt_l110_f6 m=9   $ gmb_NMOS
Nm14 VB3 VB3 GNDA GNDA nsvt_l128_f4 m=4   $ BIASCM_NMOS
I0 net013 GNDA 6.99932e-07
C1 net050 VOUT 1e-12
