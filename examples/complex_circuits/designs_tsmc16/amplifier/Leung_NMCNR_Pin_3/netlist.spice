Nm9 net063 VINP net31 net31 psvt_l120_f8 m=2   $ gm1_PMOS
Nm8 DM_2 VINN net31 net31 psvt_l120_f8 m=2   $ gm1_PMOS
Nm4 net31 net013 VDDA VDDA psvt_l90_f6 m=4   $ BIASCM_PMOS
Nm3 VB3 net013 VDDA VDDA psvt_l90_f6 m=1   $ BIASCM_PMOS
