Nm1 VB4 net013 VDDA VDDA psvt_l90_f6 m=1   $ BIASCM_PMOS
Nm0 net013 net013 VDDA VDDA psvt_l90_f6 m=1   $ BIASCM_PMOS
Nm23 VOUT net049 GNDA GNDA nsvt_l120_f12 m=6   $ gm3_NMOS
Nm22 net049 net043 GNDA GNDA nsvt_l180_f4 m=1   $ LOAD2_NMOS
Nm21 net043 net043 GNDA GNDA nsvt_l180_f4 m=1   $ LOAD2_NMOS
Nm19 DM_2 VB4 GNDA GNDA nsvt_l90_f8 m=8   $ BIASCM_NMOS
Nm15 VOUTN VB3 DM_2 GNDA nsvt_l90_f8 m=4   $ BIASCM_NMOS
Nm20 net063 VB4 GNDA GNDA nsvt_l90_f8 m=8   $ BIASCM_NMOS
Nm16 net050 VB3 net063 GNDA nsvt_l90_f8 m=4   $ BIASCM_NMOS
Nm17 net54 VB4 GNDA GNDA nsvt_l90_f8 m=4   $ BIASCM_NMOS
Nm14 VB3 VB3 GNDA GNDA nsvt_l90_f8 m=1   $ BIASCM_NMOS
Nm12 VB4 VB3 net54 GNDA nsvt_l90_f8 m=4   $ BIASCM_NMOS
Nm18 net56 VB4 GNDA GNDA nsvt_l90_f8 m=4   $ BIASCM_NMOS
Nm13 DM_1 VB3 net56 GNDA nsvt_l90_f8 m=4   $ BIASCM_NMOS
I0 net013 GNDA 6.12245e-07
