# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
*.egg-info/
dist/
build/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Simulation results (generated at runtime)
results/
tests/verify_*_results/

# NGSPICE output files
*.lis
*.csv

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Debug / temp files
*.out
debug_*
*.log

# Duplicate model files (originals in pycircuitsim/models/)
external_compact_models/*.py

# BSIMAR checkpoints (large binaries, regenerable via training)
external_compact_models/bsimar/checkpoints/
# Legacy path (kept for history)
external_compact_models/BSIMAR/checkpoints/

# Experiment temp files
exp_pids.txt
exp_queue.log

# Claude Code
.claude_statusline_exec.sh
nn_model/data/datasets/*.npz

# BSIMAR training datasets (large binaries, regenerable via PyCMG)
external_compact_models/bsimar/data/datasets/
external_compact_models/bsimar/data/datasets_v3/
external_compact_models/bsimar/data/datasets_v4_lhs/
external_compact_models/bsimar/data/datasets_tmp_for_d1/

# Local Claude tool config
.claude/

# Training / data-gen / validation logs (regenerable; can be very large)
training_logs/
logs/

# Local V6.3.1 checkpoint backup (kept on disk for rollback; not tracked)
v6_3_1_checkpoints/
/tools/
external_compact_models/bsimar/data/datasets_v2_backup/
# V7.4.0 datasets + checkpoints, kept on disk as the control the V7.4.2
# L-densified rebuild is measured against (docs/plans/2026-08-10-v742-*).
external_compact_models/bsimar/v740_archive/

# PyCMG (vendored in-repo since V7.4.1; was a git submodule).
# PyCMG/.gitignore covers build*/ and the IP-protected TSMC modelcards;
# the modelcards archive (and local backups of it) must never be committed.
external_compact_models/PyCMG/modelcards.tar.gz*
